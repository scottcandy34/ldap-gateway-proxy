{
  "name": "ldap-gateway-proxy",
  "version": "0.2.2",
  "private": true,
  "description": "SNI reverse proxy for LDAP and LDAPS. One port, many hostnames, OpenLDAP backends.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
